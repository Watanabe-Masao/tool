{
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build && open dist/stats.html",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint scripts/**/*.js tests/**/*.js",
    "lint:fix": "eslint scripts/**/*.js tests/**/*.js --fix",
    "validate:imports": "node tests/validate-imports.js",
    "validate": "npm run validate:imports && npm run lint"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "eslint": "^8.57.0",
    "fake-indexeddb": "^6.2.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "pngjs": "^7.0.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "vite": "^7.2.1"
  }
}
