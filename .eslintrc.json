{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    // ログ管理（logger.jsを使用すること）
    "no-console": "error",

    // コード品質
    "no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_"
    }],
    "no-var": "error",
    "prefer-const": "warn",
    "prefer-arrow-callback": "warn",
    "no-shadow": "warn",

    // エラー防止
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-throw-literal": "error",
    "no-implicit-coercion": "warn",
    "no-return-await": "warn",
    "require-await": "warn",

    // ベストプラクティス
    "curly": ["warn", "all"],
    "default-case": "warn",
    "no-else-return": "warn",
    "no-lonely-if": "warn",
    "no-useless-return": "warn",
    "yoda": "warn",

    // ES6+
    "object-shorthand": "warn",
    "prefer-destructuring": ["warn", {
      "array": false,
      "object": true
    }],
    "prefer-template": "warn",
    "prefer-spread": "warn",

    // 可読性
    "max-depth": ["warn", 4],
    "max-nested-callbacks": ["warn", 3],
    "max-params": ["warn", 5],
    "no-negated-condition": "warn",

    // セキュリティ
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",

    // XSS対策: innerHTML の使用を制限
    "no-restricted-syntax": [
      "error",
      {
        "selector": "AssignmentExpression[left.property.name='innerHTML']",
        "message": "Avoid using innerHTML directly. Use the sanitizer module (escapeHTML, html, htmlWithRaw) to prevent XSS attacks. If you must use innerHTML, ensure all user input is properly escaped."
      },
      {
        "selector": "CallExpression[callee.property.name='insertAdjacentHTML']",
        "message": "Avoid using insertAdjacentHTML directly. Use the sanitizer module to prevent XSS attacks."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "scripts/core/logger.js",
        "scripts/firebase-config.example.js"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["tests/**/*.js", "__tests__/**/*.js"],
      "env": {
        "jest": true
      },
      "rules": {
        "no-console": "off",
        "max-nested-callbacks": "off"
      }
    },
    {
      "files": [
        "scripts/core/sanitizer.js"
      ],
      "rules": {
        "no-restricted-syntax": "off",
        "no-unused-vars": "off"
      }
    },
    {
      "files": [
        "scripts/toast.js",
        "scripts/multi-pattern-ui.js",
        "scripts/history-item-renderer.js",
        "scripts/yield-stats-display.js",
        "scripts/yield-stats-display/**/*.js",
        "scripts/multi-pattern-ui/**/*.js",
        "scripts/db/**/*.js",
        "scripts/firebase-sync/**/*.js"
      ],
      "rules": {
        "no-restricted-syntax": "warn"
      }
    },
    {
      "files": [
        "scripts/db/connection.js"
      ],
      "rules": {
        "no-async-promise-executor": "warn",
        "require-await": "off"
      }
    }
  ]
}
