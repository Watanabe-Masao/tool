{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": [
      "error",
      {
        "allow": []
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "scripts/core/logger.js",
        "scripts/firebase-config.example.js"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
